Cell[TextData[{
 "At first order in \\varepsilon ",
 Cell[BoxData[
  SuperscriptBox["Cthetaphi", "2"]], "Output",
  CellChangeTimes->{{3.9309738251265526`*^9, 3.930973871262909*^9}},
  ExpressionUUID->"141453e8-8901-4434-8939-aab54301193c"],
 "==0 if the background Kerr spacetime in BS coordinates has Cthetaphi=0 as \
it does in BS coords we use.\n\nThen the condition reduces to \
q^{AB}C_{AB}^{(1)}=0."
}], "Text",
 CellChangeTimes->{{3.930973912218751*^9, 3.9309739594976454`*^9}, {
