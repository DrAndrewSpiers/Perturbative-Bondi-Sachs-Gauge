Cell[CellGroupData[{

Cell["Relate the BS and BL coordinate schems", "Subsection",
 CellChangeTimes->{{3.9606257088452806`*^9, 3.9606257191392345`*^9}, {
  3.9606258567938013`*^9, 
  3.9606258675512133`*^9}},ExpressionUUID->"845501d1-e232-4a24-a616-\
5b5fe800a6da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BScoordsToBLcoords", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"uBS", "[", "]"}], "->", 
     RowBox[{
      RowBox[{"t", "[", "]"}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "[", "]"}], "+", 
        RowBox[{"2", "M", " ", 
         RowBox[{"Log", "[", 
          RowBox[{
           RowBox[{"r", "[", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "M"}], ")"}]}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", 
            RowBox[{"M", "^", "2"}]}], "-", 
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", 
            RowBox[{"A", "^", "2"}], 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}]}]}], ")"}], "/", 
         RowBox[{"r", "[", "]"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", 
            RowBox[{"M", "^", "3"}]}], "-", 
           RowBox[{"M", " ", 
            RowBox[{"A", "^", "2"}]}]}], ")"}], "/", 
         RowBox[{
          RowBox[{"r", "[", "]"}], "^", "2"}]}]}], ")"}]}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rBS", "[", "]"}], "\[Rule]", 
     RowBox[{
      RowBox[{"r", "[", "]"}], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["A", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}], "2"]}], 
       RowBox[{"2", " ", 
        RowBox[{"r", "[", "]"}]}]], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["A", "2"], " ", "M", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}], "2"]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"r", "[", "]"}], "2"]}]]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]BS", "[", "]"}], "->", 
     RowBox[{
      RowBox[{"\[Theta]", "[", "]"}], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["A", "2"], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"r", "[", "]"}], "2"]}]]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]BS", "[", "]"}], "->", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "]"}], "+", 
      FractionBox[
       RowBox[{"A", " ", "M"}], 
       SuperscriptBox[
        RowBox[{"r", "[", "]"}], "2"]], "+", 
      FractionBox[
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"A", " ", 
          SuperscriptBox["M", "2"]}], ")"}]}], 
       RowBox[{"3", " ", 
        SuperscriptBox[
         RowBox[{"r", "[", "]"}], "3"]}]]}]}]}], "\[IndentingNewLine]", 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.9356618762900114`*^9, 3.9356618954137154`*^9}, {
  3.935661994115563*^9, 3.9356620402796984`*^9}, {3.985066181338121*^9, 
  3.98506618157222*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"0ea3b6cc-7ba2-4173-8623-af40f6411747"],

