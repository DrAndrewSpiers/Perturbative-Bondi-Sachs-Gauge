   RowBox[{"DefManifold", "[", 
    RowBox[{"S2", ",", "2", ",", 
     RowBox[{"{", 
      RowBox[{"A", ",", "B", ",", "C", ",", "D"}], "}"}]}], "]"}], "\n", 
   RowBox[{"DefMetric", "[", 
    RowBox[{"1", ",", 
     RowBox[{"\[CapitalOmega]", "[", 
      RowBox[{
       RowBox[{"-", "A"}], ",", 
       RowBox[{"-", "B"}]}], "]"}], ",", "CD", ",", 
     RowBox[{"SymbolOfCovD", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<|\>\"", ",", "\"\<D\>\""}], "}"}]}], ",", 
     RowBox[{"PrintAs", "->", "\"\<\[CapitalOmega]\>\""}]}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "small", " ", "parameter", " ", "l", 
     RowBox[{"(", 
      RowBox[{"l", "+", "1"}], ")"}], " ", "as", " ", "a", " ", "constant"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DefConstantSymbol", "[", 
    RowBox[{"llp1", ",", 
     RowBox[{"PrintAs", "->", "\"\<l(l+1)\>\""}]}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "relevant", " ", "tensors"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"Y", "[", "]"}], ",", "S2", ",", 
     RowBox[{"PrintAs", "->", "\"\<Y\>\""}]}], "]"}], 
   "                           ", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "harmonic"}], "*)"}], "\n", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"\[Delta]\[Theta]", "[", "A", "]"}], ",", "S2", ",", 
     RowBox[{"PrintAs", "->", "\"\<\[Delta]\[Theta]\>\""}]}], "]"}], 
   "        ", 
   RowBox[{"(*", 
    RowBox[{"Coordinate", " ", "shift", " ", "vector"}], "*)"}], "\n", 
   RowBox[{"DefTensor", "[", 
    RowBox[{
     RowBox[{"YTF", "[", 
      RowBox[{
       RowBox[{"-", "A"}], ",", 
