Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Load", " ", "the", " ", "xTensor", " ", "package"}], "*)"}], 
  RowBox[{
   RowBox[{"Needs", "[", "\"\<xAct`xTensor`\>\"", "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1.", " ", "Define", " ", "the", " ", "2"}], "-", 
