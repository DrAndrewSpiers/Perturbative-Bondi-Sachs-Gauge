     RowBox[{"Symmetric", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "A"}], ",", 
        RowBox[{"-", "B"}]}], "}"}], "]"}], ",", 
     RowBox[{
     "PrintAs", 
      "->", "\"\<\\!\\(\\*SubscriptBox[\\(Y\\), \\(\[LeftAngleBracket]AB\
\[RightAngleBracket]\\)]\\)\>\""}]}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"STF", " ", "tensor", " ", "harmonic"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Define", " ", "the", " ", "Even", " ", 
     RowBox[{"(", "Z", ")"}], " ", "and", " ", "Odd", " ", 
     RowBox[{"(", "X", ")"}], " ", "Vector", " ", "Harmonics"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ZHarmonic", "[", 
     RowBox[{"-", "A_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"CD", "[", 
      RowBox[{"-", "A"}], "]"}], "[", 
     RowBox[{"Y", "[", "]"}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Note", ":", 
